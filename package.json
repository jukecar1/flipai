    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
